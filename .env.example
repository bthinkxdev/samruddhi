# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://samruddhi:samruddhi@localhost:5432/samruddhi

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS S3 (optional)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=me-south-1
AWS_S3_CUSTOM_DOMAIN=

# Language
LANGUAGE_CODE=en

# Google OAuth
GOOGLE_CLIENT_ID=

# Accounts OTP
ACCOUNTS_OTP_EXPIRY_SECONDS=300
ACCOUNTS_OTP_MAX_ATTEMPTS=5
ACCOUNTS_GUEST_TOKEN_MAX_AGE=86400

# Razorpay
# Must match the webhook secret configured in the Razorpay dashboard for the
# webhooks/razorpay/ endpoint specifically (separate from any other webhook's secret,
# e.g. the existing Odoo webhook's secret — do not reuse either one).
RAZORPAY_WEBHOOK_SECRET=

# Meta Pixel (storefront tracking). Leave META_PIXEL_ID empty to disable all events.
# META_CAPI_ACCESS_TOKEN enables the server-side Conversions API Purchase event (Events Manager > Settings).
# META_TEST_EVENT_CODE: set only while verifying in Events Manager > Test events, then remove.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_API_VERSION=v21.0
